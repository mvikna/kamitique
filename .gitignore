# ============================================================================
#  Kamitique.jl — fichiers exclus du versionnement
# ============================================================================

# Références bibliographiques (livres PDF sources, non versionnés)
docs/*.pdf

# Dépôts Julia locaux (compilation / artefacts, non versionnés)
.julia_depot/
.julia/

# Dossiers et fichiers temporaires
*~
*.tmp
_tmp_*
_tmp_*/
.tmp_extract/

# Fichiers de compilation LaTeX
*.aux
*.log
*.toc
*.bbl
*.blg
*.synctex.gz
*.fls
*.fdb_latexmk

# Couverture de code Julia
*.jl.cov
*.jl.*.cov
*.jl.mem
lcov.info
coverage/

# Dossiers système
.DS_Store
Thumbs.db
